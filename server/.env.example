# =====================================================================
# CẤU HÌNH TRỢ LÝ GIỌNG NÓI NHẮC VIỆC CHỦ ĐỘNG (SMART VOICE ASSISTANT)
# =====================================================================

# 1. Tên người dùng & Phong cách trợ lý
USER_NAME="Chủ nhân"
ASSISTANT_NAME="Nova"
# Các phong cách: 'strict' (kỷ luật thép), 'caring' (đồng hành ấm áp), 'sarcastic' (cà khịa vui nhộn), 'best_friend'
ASSISTANT_PERSONA="best_friend"

# 2. Cấu hình Não bộ AI (LLM)
# Tùy chọn: 'gemini' (khuyến nghị cho Tool Calling & Reminders) hoặc 'groq'
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
GROQ_API_KEY=""
OPENAI_API_KEY=""

# 3. Cấu hình Voice Text-To-Speech (TTS)
# 'cuppy' (mô hình thần kinh tiếng Việt chất lượng cao), 'edge-tts' hoặc 'elevenlabs'
TTS_PROVIDER="cuppy"
CUPPY_TTS_URL="https://logo-world-limousines-cups.trycloudflare.com/api/tts"
CUPPY_LOCAL_URL="http://127.0.0.1:5055/api/tts"
CUPPY_VOICE="cuppy"
CUPPY_SPEED=1.0
CUPPY_REFERENCE_WAV="C:/Users/Lenovo/AppData/Local/WTStudio/saydi-tts-service/cuppy_sample_8_12s.wav"
CUPPY_REFERENCE_DENOISE="true"
STRICT_CUPPY_MODE="true"
CUPPY_VOICE_PRESET_PATH=""

# Nếu dùng ElevenLabs:
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Nếu dùng Edge-TTS:
# vi-VN-HoaiMyNeural (Nữ miền Nam), vi-VN-NamMinhNeural (Nam miền Bắc)
EDGE_TTS_VOICE="vi-VN-HoaiMyNeural"

# 4. Cấu hình Wake Word (Đánh thức rảnh tay)
WAKE_WORD="hey_nova"
WAKE_WORD_SENSITIVITY=0.5

