# =====================================================================
# CẤU HÌNH TRỢ LÝ GIỌNG NÓI NHẮC VIỆC CHỦ ĐỘNG (SMART VOICE ASSISTANT)
# =====================================================================

# 1. Tên người dùng & Phong cách trợ lý
USER_NAME="Chủ nhân"
# Các phong cách: 'strict' (kỷ luật thép), 'caring' (đồng hành ấm áp), 'sarcastic' (cà khịa vui nhộn)
ASSISTANT_PERSONA="strict"

# 2. Cấu hình Não bộ AI (LLM)
# Tùy chọn: 'groq' (siêu nhanh) hoặc 'openai'
LLM_PROVIDER="groq"
GROQ_API_KEY=""
OPENAI_API_KEY=""

# 3. Cấu hình Clone Giọng Nói & Text-To-Speech (TTS)
# 'edge-tts' (mặc định miễn phí, tiếng Việt siêu tự nhiên) hoặc 'elevenlabs' (clone giọng người quen)
TTS_PROVIDER="edge-tts"

# Nếu dùng ElevenLabs để Clone giọng người thật (người yêu, mentor, bạn thân):
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="" # Lấy Voice ID sau khi clone trên ElevenLabs

# Nếu dùng Edge-TTS:
# vi-VN-HoaiMyNeural (Nữ miền Nam), vi-VN-NamMinhNeural (Nam miền Bắc)
EDGE_TTS_VOICE="vi-VN-HoaiMyNeural"

# 4. Cấu hình Wake Word (Đánh thức rảnh tay)
WAKE_WORD="hey_jarvis"
WAKE_WORD_SENSITIVITY=0.5
