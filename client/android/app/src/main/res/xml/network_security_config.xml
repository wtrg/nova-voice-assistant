<?xml version="1.0" encoding="utf-8"?>
<!-- Production & Local LAN Development Network Security Config -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
